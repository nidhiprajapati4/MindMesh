{
  "name": "@mindmesh/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/modules/notes/notes.schema.test.ts src/modules/notes/url-metadata.test.ts src/modules/ai-processing/ai-processing.test.ts src/platform/generation/generation.test.ts src/test/api.test.ts src/test/phase3.test.ts src/test/phase4.test.ts src/test/phase5.test.ts src/test/phase6.test.ts src/test/phase7.test.ts",
    "worker": "tsx src/worker/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "spike:vector": "tsx scripts/vector-spike.ts",
    "reembed": "tsx scripts/reembed.ts",
    "prefetch-model": "tsx scripts/prefetch-model.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "eval:search": "tsx eval/search/run-eval.ts",
    "eval:ask": "tsx eval/ask/run-eval.ts",
    "eval:organize": "tsx eval/organize/run-eval.ts",
    "eval:connections": "tsx eval/connections/run-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^3.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "mammoth": "^1.13.0",
    "mongoose": "^8.8.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "6.4.299",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "jszip": "^3.10.2",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
