# MindMesh API settings. Copy to `.env` (git-ignored) and fill in. Only the first block is required.

# --- Required ---------------------------------------------------------------
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Free M0 clusters work.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mindmesh
# Firebase project id (Firebase console → Project settings).
FIREBASE_PROJECT_ID=your-project-id
# Firebase service account (Project settings → Service accounts → Generate new private key).
# Paste the key on one line with \n for line breaks, in double quotes.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Server -----------------------------------------------------------------
PORT=4000
# Where the web app runs (comma-separated for several), e.g. https://your-project.web.app
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# --- Search and AI (all free by default) -----------------------------------
# local = on-device model, free (default); openai = paid OpenAI embeddings (needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
# auto = Atlas Vector Search when available, else in-memory search
VECTOR_BACKEND=auto
# Per-user daily token budget for embeddings and answers
AI_DAILY_TOKEN_BUDGET=200000
# Answers: quotes = free smart quotes (default without a key); anthropic = Claude (paid, needs a key)
# ANSWER_PROVIDER=quotes
# ANTHROPIC_API_KEY=
# ANSWER_MODEL=claude-opus-5-5

# --- Operations ---------------------------------------------------------------
# separate = run `npm run dev:worker` too (default); inline = worker runs inside the API
RUN_WORKER=separate
# Requests per minute per user (uploads and saved links: 1/15 of it; suggestions: 1/5)
RATE_LIMIT_PER_MINUTE=300
# Proxies in front of the API (1 on Render), for correct client IPs
TRUST_PROXY=0
# json (hosting log viewers) or pretty (default outside production)
# LOG_FORMAT=pretty
# debug | info | warn | error | silent
# LOG_LEVEL=info

# --- Local testing only -------------------------------------------------------
# Use the Firebase Auth emulator instead of real Firebase (never in production)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
