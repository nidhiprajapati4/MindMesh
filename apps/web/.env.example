# MindMesh web app settings. Copy to `.env` (git-ignored) and fill in.
# These are built into the static site, so they are public by design: put no secrets here.

# Where the API runs: http://localhost:4000 locally, your Render URL when deployed
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Local testing only: use the Firebase Auth emulator
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
